{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/game/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-session-token, x-player-id, x-admin-token" }
      ]
    }
  ]
}
